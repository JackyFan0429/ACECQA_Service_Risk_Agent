      "properties": {
        "service_approval_number": {
          "title": "Service Approval Number",
          "type": "string"
        },
        "service_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Name"
        },
        "eligible_for_risk_scoring": {
          "title": "Eligible For Risk Scoring",
          "type": "boolean"
        },
        "gap_score": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Score"
        },
        "gap_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gap Label"
        },
        "poor_access_flag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Poor Access Flag"
        },
        "weak_quality_flag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weak Quality Flag"
        },
        "low_capacity_flag": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low Capacity Flag"
        },
        "nearest_public_transport_km": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearest Public Transport Km"
        },
        "overall_rating": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overall Rating"
        },
        "number_of_approved_places": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number Of Approved Places"
        },
        "thresholds": {
          "$ref": "#/$defs/RiskThresholds"
