  "calculate_risk_score": {
    "description": "Calculate the validated v1 three-gap risk assessment for one service approval number. Returns eligibility, the 0-3 gap score, component flags, thresholds, and limitations.",
    "input_schema": {
      "properties": {
        "service_approval_number": {
          "minLength": 1,
          "title": "Service Approval Number",
          "type": "string"
        }
      },
      "required": [
        "service_approval_number"
      ],
      "title": "CalculateRiskInput",
      "type": "object"
    },
    "output_schema": {
      "$defs": {
        "RiskThresholds": {
          "properties": {
            "transport_p75_km": {
              "title": "Transport P75 Km",
              "type": "number"
            },
            "capacity_p25_places": {
              "title": "Capacity P25 Places",
              "type": "number"
            },
            "scope": {
